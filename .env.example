# ------------------------------------------------------------------
# Unitel Global — CarrierScout AI — Environment Configuration
# Copy this file to `.env` and fill in the values.
# ------------------------------------------------------------------

# App
NODE_ENV=development
PORT=3000
BASE_URL=http://localhost:3000

# PostgreSQL connection string (Prisma)
# Example: postgresql://USER:PASSWORD@localhost:5432/carrierscout?schema=public
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carrierscout?schema=public

# Authentication
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Set to "true" to allow anyone to self-register.
# When "false" (recommended), only admins create accounts (the first-ever user becomes admin automatically).
ALLOW_PUBLIC_REGISTRATION=false

# Google Gemini (server-side only — never exposed to the browser)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# SMTP — real outreach email sending (leave blank to disable sending)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Unitel Global — Carrier Relations
SMTP_FROM_EMAIL=info@unitelglobal.com

# Required for Resend webhooks. Set to the Signing Secret used by both
# POST /api/webhooks/resend and POST /api/inbound/resend. The endpoints fail
# closed when this value is absent.
RESEND_WEBHOOK_SECRET=

# Resend API key for inbound reply fetching and Resend-native APIs.
RESEND_API_KEY=

# Inbound mailbox address used to catch replies to sent pitches.
INBOUND_EMAIL_ADDRESS=replies@eventnexus.eu

# Seed admin (used by `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@unitelglobal.com
SEED_ADMIN_NAME=Unitel Global Admin
SEED_ADMIN_PASSWORD=ChangeMe123!
