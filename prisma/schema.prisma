// Prisma schema for Unitel Global — CarrierScout AI
// Shared team B2B platform: users, leads, CRM pipeline, outreach pitches, activity log.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application user (Unitel Global B2B worker).
model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads Lead[]        @relation("AssignedAgent")
  createdLeads  Lead[]        @relation("LeadCreator")
  pitches       Pitch[]
  activities    ActivityLog[]
  createdTemplates PitchTemplate[] @relation("TemplateCreator")
  deals         Deal[]        @relation("AgentDeals")
  commissions   Commission[]  @relation("AgentCommissions")
  routingRules  LeadRoutingRule[] @relation("RoutingAgent")
  meetingSlots  MeetingSlot[] @relation("MeetingSlots")
  availabilityRules AvailabilityRule[] @relation("AvailabilityRules")
  bookingLinks BookingLink[] @relation("BookingAgents")
  createdDocuments GeneratedDocument[] @relation("DocumentCreator")
  apiKeys ApiKey[] @relation("ApiKeys")
  sendTimeOptimizations SendTimeOptimization[] @relation("SendTimeOptimizations")
  coachingInsights AgentCoaching[] @relation("AgentCoaching")
  scheduledMeetings Meeting[] @relation("AgentMeetings")

  @@index([role])
  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

/// Key/value application settings editable from the UI (overrides .env at runtime).
/// Secret values (API keys, passwords) are stored encrypted; `isSecret` marks them.
model AppSetting {
  key         String   @id
  value       String   @default("")
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("app_settings")
}

/// A B2B company lead in the shared team pipeline.
model Lead {
  id             String     @id @default(cuid())
  name           String
  website        String
  domain         String // normalized website host (lowercase, no protocol/www) for dedupe
  category       String
  email          String
  description    String     @default("")
  phone          String?
  sourceUrl      String?
  focus          String? // LeadFocus segment (voip_carriers, sms_aggregators, ...)
  source         LeadSource @default(AI_SCOUT)
  isVerified     Boolean    @default(false)
  stage          LeadStage  @default(DISCOVERED)
  notes          String     @default("")
  estimatedValue Int        @default(0) // Potential monthly value in EUR
  aiScore        Int?       // AI-calculated conversion probability 0-100
  aiScoreReason  String?    // Explanation for the AI score
  enrichmentData String?    // JSON: company size, tech stack, news, decision makers
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  lastContactedAt DateTime?

  assignedAgentId String?
  assignedAgent   User?   @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  followUpTask FollowUpTask?
  meetings     Meeting[]
  pitches      Pitch[]
  activities   ActivityLog[]
  customFieldValues CustomFieldValue[]
  sequenceExecutions SequenceExecution[]
  deals Deal[]
  documents GeneratedDocument[]
  monitoringAlerts LeadMonitoring[]
  sendTimeOptimizations SendTimeOptimization[]
  bookingLinks BookingLink[]

  @@unique([website, email])
  @@index([domain])
  @@index([email])
  @@index([stage])
  @@index([assignedAgentId])
  @@index([focus])
  @@map("leads")
}

enum LeadStage {
  DISCOVERED
  CONTACTED
  NEGOTIATION
  SIGNED
  ACTIVE
  ARCHIVED
}

enum LeadSource {
  AI_SCOUT
  MANUAL
  CSV_IMPORT
  PITCH_REPLY
  OTHER
}

/// A single actionable follow-up task attached to a lead.
model FollowUpTask {
  id          String   @id @default(cuid())
  taskName    String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_up_tasks")
}

/// A scheduled meeting/call/demo with a lead.
model Meeting {
  id        String      @id @default(cuid())
  title     String
  date      String // YYYY-MM-DD
  time      String // HH:MM
  duration  Int         @default(30) // minutes
  type      MeetingType @default(CALL)
  agenda    String      @default("")
  link      String?
  timezone  String      @default("Europe/Tallinn")
  createdAt DateTime    @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pitchId String?
  pitch   Pitch?  @relation("MeetingPitches", fields: [pitchId], references: [id], onDelete: SetNull)

  agentId String?
  agent   User?   @relation("AgentMeetings", fields: [agentId], references: [id], onDelete: SetNull)

  slots MeetingSlot[]
  bookingLink BookingLink?

  @@index([leadId])
  @@index([agentId])
  @@map("meetings")
}

/// Available time slots for booking (Calendly-like)
model MeetingSlot {
  id          String   @id @default(cuid())
  date        String   // YYYY-MM-DD
  startTime   String   // HH:MM
  endTime     String   // HH:MM
  timezone    String   @default("Europe/Tallinn")
  isAvailable Boolean  @default(true)
  isBooked    Boolean  @default(false)
  agentId     String
  agent       User     @relation("MeetingSlots", fields: [agentId], references: [id])
  meetingId   String?  // linked meeting if booked
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([date])
  @@unique([agentId, date, startTime])
  @@map("meeting_slots")
}

/// A recurring weekly availability window for an agent.
model AvailabilityRule {
  id           String   @id @default(cuid())
  weekday      Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)
  timezone     String   @default("Europe/Tallinn")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentId String
  agent   User @relation("AvailabilityRules", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, weekday])
  @@index([agentId, isActive])
  @@map("availability_rules")
}

/// Capability link included in outreach emails for public meeting booking.
model BookingLink {
  id        String   @id @default(cuid())
  token     String   @unique
  expiresAt DateTime
  bookedAt  DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pitchId String @unique
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agentId String
  agent   User @relation("BookingAgents", fields: [agentId], references: [id], onDelete: Cascade)

  meetingId String?  @unique
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([leadId])
  @@index([expiresAt])
  @@map("booking_links")
}

enum MeetingType {
  CALL
  MEETING
  DEMO
  FOLLOW_UP
}

/// A generated / sent outreach email pitch.
model Pitch {
  id              String      @id @default(cuid())
  subject         String
  htmlContent     String
  textContent     String
  language        String      @default("English")
  status          PitchStatus @default(DRAFT)
  opened          Boolean     @default(false)
  sentAt          DateTime?
  scheduledSendAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadName  String
  leadEmail String

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sentFromEmail String? // actual sender email used at send time (for audit)
  sentFromName  String? // actual sender name used at send time
  replyToEmail  String? // where replies should go (agent email or SMTP from)
  sentMessageId String? // SMTP Message-ID for reply threading

  inReplyTo Pitch?   @relation("ReplyChain", fields: [inReplyToId], references: [id], onDelete: SetNull)
  inReplyToId String? @unique
  replies Pitch[] @relation("ReplyChain")
  meetings Meeting[] @relation("MeetingPitches")
  bookingLink BookingLink?

  events PitchEvent[]

  @@index([leadId])
  @@index([status])
  @@map("pitches")
}

enum PitchStatus {
  DRAFT
  SENT
  DELIVERED
  REPLIED
  FAILED
}

/// Audit trail of actions across the team pipeline.
model ActivityLog {
  id        String   @id @default(cuid())
  action    String
  detail    String   @default("")
  createdAt DateTime @default(now())
  readAt    DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([userId, readAt])
  @@map("activity_logs")
}

/// Individual pitch delivery/open event from Resend webhook or manual tracking.
model PitchEvent {
  id        String      @id @default(cuid())
  pitchId   String
  pitch     Pitch       @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  type      PitchEventType
  createdAt DateTime    @default(now())

  @@index([pitchId])
  @@map("pitch_events")
}

enum PitchEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  FAILED
}

/// Saved pitch template for reuse across the team.
model PitchTemplate {
  id          String   @id @default(cuid())
  name        String
  subject     String
  htmlContent String
  textContent String
  focus       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("pitch_templates")
}

/// Custom field definition for leads (admin-configurable).
model CustomFieldDefinition {
  id          String   @id @default(cuid())
  name        String
  key         String   // machine-readable key, e.g. "contract_value"
  type        CustomFieldType @default(TEXT)
  options     String? // JSON array for SELECT/MULTISELECT types
  isRequired  Boolean  @default(false)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  values      CustomFieldValue[]

  @@unique([key])
  @@map("custom_field_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

/// Value of a custom field for a specific lead.
model CustomFieldValue {
  id          String   @id @default(cuid())
  value       String   // stored as string, cast based on field type
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([leadId])
  @@index([fieldId])
  @@map("custom_field_values")
}

/// Custom pipeline stage (admin-configurable, replaces default LeadStage when active).
model DealStage {
  id          String   @id @default(cuid())
  name        String
  key         String   @unique // machine-readable key, e.g. "demo_scheduled"
  color       String   @default("#64748b") // hex color for UI
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("deal_stages")
}

/// Automated follow-up sequence (e.g. "Cold Outreach", "Demo Follow-up").
model FollowUpSequence {
  id          String   @id @default(cuid())
  name        String
  description String   @default("")
  triggerStage String // LeadStage key that triggers this sequence
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  steps       SequenceStep[]
  executions  SequenceExecution[]

  @@map("follow_up_sequences")
}

/// Single step in a follow-up sequence.
model SequenceStep {
  id          String   @id @default(cuid())
  order       Int
  delayDays   Int      @default(0) // days after previous step
  actionType  SequenceActionType @default(TASK)
  subject     String?
  body        String?
  taskName    String?
  isActive    Boolean  @default(true)
  triggerEvent PitchEventType? // pitch event that triggers this step
  eventDelayDays Int?    // delay in days when trigger event fires (null = use delayDays)
  stopOnEvent   Boolean @default(false) // complete sequence when trigger event fires
  createdAt   DateTime   @default(now())
  updatedAt   DateTime @updatedAt

  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum SequenceActionType {
  EMAIL
  TASK
  WEBHOOK
}

/// Execution of a sequence for a specific lead.
model SequenceExecution {
  id          String   @id @default(cuid())
  status      SequenceExecutionStatus @default(ACTIVE)
  currentStep Int      @default(0)
  startedAt   DateTime @default(now())
  completedAt DateTime?
  nextRunAt   DateTime?
  lastEventCheckedAt DateTime? // last time pitch events were checked for trigger events

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([sequenceId])
  @@map("sequence_executions")
}

enum SequenceExecutionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

/// A closed-won deal with value and commission tracking.
model Deal {
  id             String        @id @default(cuid())
  leadId         String
  lead           Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value          Int           // Total deal value in EUR
  commissionRate Float         @default(10.0) // Agent commission percentage
  commission     Int           // Commission amount in EUR
  agentId        String
  agent          User          @relation("AgentDeals", fields: [agentId], references: [id])
  closedAt       DateTime      @default(now())
  notes          String        @default("")
  commissions    Commission[]

  @@index([agentId])
  @@index([closedAt])
  @@map("deals")
}

/// Commission record for an agent on a specific deal.
model Commission {
  id         String   @id @default(cuid())
  dealId     String
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agentId    String
  agent      User     @relation("AgentCommissions", fields: [agentId], references: [id])
  amount     Int      // Commission in EUR
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([agentId])
  @@index([status])
  @@map("commissions")
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

/// Automated lead routing rules for assigning leads to agents.
model LeadRoutingRule {
  id          String   @id @default(cuid())
  name        String
  isActive    Boolean  @default(true)
  priority    Int      @default(0)
  ruleType    RoutingRuleType
  criteria    String   // JSON: { territory: "...", focus: "...", maxLeads: 5 }
  assignedAgentId String
  assignedAgent   User   @relation("RoutingAgent", fields: [assignedAgentId], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([assignedAgentId])
  @@index([isActive])
  @@map("lead_routing_rules")
}

enum RoutingRuleType {
  TERRITORY
  INDUSTRY
  ROUND_ROBIN
  MANUAL
  SCORE_BASED
}

/// Document template for proposals, contracts, etc.
model DocumentTemplate {
  id          String   @id @default(cuid())
  name        String
  type        DocumentType
  content     String   // HTML or markdown template
  variables   String   @default("[]") // JSON array of available variables
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@map("document_templates")
}

/// Generated document for a lead/deal
model GeneratedDocument {
  id          String   @id @default(cuid())
  title       String
  type        DocumentType
  content     String   // Final rendered HTML
  pdfUrl      String?  // Path to generated PDF
  leadId      String?
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User     @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  @@index([leadId])
  @@index([type])
  @@map("generated_documents")
}

enum DocumentType {
  PROPOSAL
  CONTRACT
  NDA
  QUOTE
  INVOICE
  CUSTOM
}

/// API keys for external integrations (Zapier, Make, custom scripts).
model ApiKey {
  id         String   @id @default(cuid())
  name       String
  key        String   @unique
  keyPrefix  String
  scopes     String   @default("[]")
  isRevoked  Boolean  @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())

  userId String
  user   User   @relation("ApiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

/// Monitoring alert for a lead (news, events, changes).
model LeadMonitoring {
  id           String        @id @default(cuid())
  leadId       String
  lead         Lead          @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type         MonitoringType @default(NEWS)
  title        String
  description  String        @default("")
  source       String?       // URL or source name
  isRead       Boolean       @default(false)
  createdAt    DateTime      @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_monitoring")
}

enum MonitoringType {
  NEWS
  EVENT
  FUNDING
  HIRING
  COMPETITOR
  CUSTOM
}

/// Send-time optimization record for a lead/agent combination.
model SendTimeOptimization {
  id           String   @id @default(cuid())
  leadId       String
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId      String?
  agent        User?    @relation("SendTimeOptimizations", fields: [agentId], references: [id], onDelete: SetNull)
  recommendedHour Int    // 0-23
  recommendedDay  String // "Monday", "Tuesday", etc.
  confidence   Int      // 0-100
  reason       String   @default("")
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?

  @@index([leadId])
  @@index([agentId])
  @@map("send_time_optimizations")
}

/// Agent coaching insight based on performance analysis.
model AgentCoaching {
  id           String   @id @default(cuid())
  agentId      String
  agent        User     @relation("AgentCoaching", fields: [agentId], references: [id], onDelete: Cascade)
  insightType  String   // "STAGE_TRANSITION", "RESPONSE_RATE", "PITCH_QUALITY", "FOLLOW_UP", "GENERAL"
  title        String
  description  String
  priority     String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  isRead       Boolean  @default(false)
  isResolved   Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@map("agent_coaching")
}

