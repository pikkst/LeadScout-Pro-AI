model SequenceSenderRotation {
  id           String   @id @default(cuid()) @db.VarChar(32)
  sequenceId   String?
  playbookId   String?
  senderIds    String[]
  rotationMode String   @default("ROUND_ROBIN")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

