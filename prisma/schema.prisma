}

model WorkloadCap {
  id             String   @id @default(cuid()) @db.VarChar(32)
  userId         String   @unique
  maxActiveLeads Int
  maxActiveDeals Int
  maxQueueItems  Int
  currentLoad    Int      @default(0)
  alertThreshold Float    @default(0.8)
  user           User     @relation("UserWorkload", fields: [userId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([userId])
  @@map("workload_caps")
}

model OutboundWebhook {
  id            String    @id @default(cuid()) @db.VarChar(32)
  name          String
  url           String
  secret        String?
  events        String[]
  isActive      Boolean   @default(true)
  retryCount    Int       @default(3)
  timeoutMs     Int       @default(5000)
  lastError     String?
  lastSuccessAt DateTime?
  createdById   String
  createdBy     User      @relation("WebhookCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([createdById])
  @@index([isActive])
  @@map("outbound_webhooks")
}

model IntegrationMapping {
  id          String   @id @default(cuid()) @db.VarChar(32)
  provider    String
  mappingType String
  mapping     String   @default("{}")
  isActive    Boolean  @default(true)
  createdById String
  createdBy   User     @relation("IntegrationMappingCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([provider])
  @@index([createdById])
  @@map("integration_mappings")
}

model PlaybookPack {
  id                     String         @id @default(cuid()) @db.VarChar(32)
  name                   String
  slug                   String         @unique
  description            String         @default("")
  visibility             PackVisibility @default(PRIVATE)
  vertical               String?        @default("")
  isActive               Boolean        @default(true)
  icpSignals             String         @default("[]")
  disqualificationRules  String         @default("[]")
  objectionHandling      String         @default("[]")
  pricingModel           String         @default("{}")
  complianceRequirements String         @default("[]")
  createdById            String
  createdBy              User           @relation("PackCreator", fields: [createdById], references: [id], onDelete: Cascade)
  items                  PackItem[]
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  @@index([visibility, vertical])
  @@index([createdById])
  @@map("playbook_packs")
}

model PackItem {
  id         String @id @default(cuid()) @db.VarChar(32)
  packId     String
  playbookId String
  sortOrder  Int    @default(0)

  pack     PlaybookPack @relation(fields: [packId], references: [id], onDelete: Cascade)
  playbook Playbook     @relation("PackItems", fields: [playbookId], references: [id], onDelete: Cascade)

  @@unique([packId, playbookId])
  @@index([packId, sortOrder])
  @@map("pack_items")
}

model AgentDefinition {
  id                String     @id @default(cuid()) @db.VarChar(32)
  name              String
  type              AgentType
  description       String     @default("")
  config            Json       @default("{}")
  budget            Int        @default(0)
  spentBudget       Int        @default(0)
  permissions       Json       @default("{}")
  approvalThreshold Int        @default(0)
  isActive          Boolean    @default(true)
  createdById       String
  createdBy         User       @relation("AgentCreator", fields: [createdById], references: [id], onDelete: Cascade)
  runs              AgentRun[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([type, isActive])
  @@index([createdById])
  @@map("agent_definitions")
}

model AgentRun {
  id           String      @id @default(cuid()) @db.VarChar(32)
  definitionId String
  status       AgentStatus @default(IDLE)
  input        Json        @default("{}")
  output       Json        @default("{}")
  cost         Int         @default(0)
  errors       String      @default("[]")
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())

  definition AgentDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  approvals  AgentApproval[]

  @@index([definitionId, status, createdAt])
  @@index([status, createdAt])
  @@map("agent_runs")
}

model AgentApproval {
  id           String         @id @default(cuid()) @db.VarChar(32)
  status       ApprovalStatus @default(PENDING)
  comment      String         @default("")
  reviewedAt   DateTime?
  reviewedById String?
  reviewedBy   User?          @relation("AgentApprover", fields: [reviewedById], references: [id], onDelete: SetNull)
  runId        String
  run          AgentRun       @relation(fields: [runId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())

  @@index([runId, status])
  @@index([createdAt])
  @@map("agent_approvals")
}

model AccountRank {
  id                    String    @id @default(cuid()) @db.VarChar(32)
  accountId             String    @unique
  account               Account   @relation("AccountRanks", fields: [accountId], references: [id], onDelete: Cascade)
  fitScore              Int       @default(0)
  timingScore           Int       @default(0)
  relationshipScore     Int       @default(0)
  valueScore            Int       @default(0)
  compositeScore        Int       @default(0)
  explanation           String    @default("")
  evidence              Json      @default("[]")
  calculatedAt          DateTime  @default(now())
  lastDecayedAt         DateTime?
  decayedCompositeScore Int       @default(0)
  isDecayed             Boolean   @default(false)

  @@index([compositeScore, calculatedAt])
  @@map("account_ranks")
}

model Signal {
  id             String          @id @default(cuid()) @db.VarChar(32)
  type           SignalType
  source         String
  evidence       String          @default("")
  confidence     Float           @default(0)
  isVerified     Boolean         @default(false)
  rawPayload     Json?
  ingestedAt     DateTime        @default(now())
  verifiedAt     DateTime?
  accountSignals AccountSignal[]

  @@index([type, isVerified, ingestedAt])
  @@map("signals")
}

model AccountSignal {
  id        String    @id @default(cuid()) @db.VarChar(32)
  accountId String
  signalId  String
  relevance Float     @default(0)
  freshness Int       @default(0)
  decayRate Float     @default(0.1)
  context   String?   @default("")
  createdAt DateTime  @default(now())
  decayedAt DateTime?

  account Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  signal  Signal  @relation(fields: [signalId], references: [id], onDelete: Cascade)

  @@index([accountId, relevance])
  @@index([signalId])
  @@map("account_signals")
}

model WorkspaceLearningProfile {
  id           String   @id @default(cuid()) @db.VarChar(32)
  workspaceKey String   @unique
  profile      Json     @default("{}")
  updatedAt    DateTime @updatedAt

  @@index([workspaceKey])
  @@map("workspace_learning_profiles")
}

/// Solo-to-team threshold configuration per workspace.
model WorkspaceThreshold {
  id                     String    @id @default(cuid()) @db.VarChar(32)
  workspaceKey           String    @unique
  soloMode               Boolean   @default(true)
  autoPromoteUsers       Int       @default(3)
  autoPromoteLeads       Int       @default(50)
  autoPromoteAutomation  Int       @default(20)
  currentUserCount       Int       @default(1)
  currentLeadCount       Int       @default(0)
  currentAutomationCount Int       @default(0)
  promotedAt             DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  owner User? @relation("UserWorkspaceThresholds", fields: [id], references: [id], onDelete: Cascade)

  @@index([workspaceKey])
  @@map("workspace_thresholds")
}

/// Evidence review gate for AI recommendations before they can be approved into sequences, pitches, or tasks.
model EvidenceReview {
  id             String               @id @default(cuid()) @db.VarChar(32)
  entityType     EvidenceEntityType
  entityId       String
  recommendation String
  sources        Json                 @default("[]")
  confidence     Float
  freshness      Int                  @default(0)
  status         EvidenceReviewStatus @default(PENDING)
  reviewedById   String?
  reviewedBy     User?                @relation("EvidenceReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  comment        String               @default("")
  reviewedAt     DateTime?
  createdById    String
  createdBy      User                 @relation("EvidenceReviewCreator", fields: [createdById], references: [id], onDelete: Cascade)
  decayedAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@index([entityType, entityId, status])
  @@index([createdById])
  @@map("evidence_reviews")
}

/// Full audit trail for automated actions (sequences, agents, pitches, CRM updates).
model AutomationAuditLog {
  id            String               @id @default(cuid()) @db.VarChar(32)
  actionType    AutomationActionType
  entityType    AutomationEntityType
  entityId      String
  actorType     AutomationActorType
  actorId       String
  previousState Json?
  newState      Json?
  budgetUsed    Int                  @default(0)
  tokenUsed     Int                  @default(0)
  approvalId    String?
  error         String?
  executedAt    DateTime?
  createdAt     DateTime             @default(now())

  @@index([entityType, entityId, createdAt])
  @@index([actorType, actorId])
  @@index([createdAt])
  @@map("automation_audit_logs")
}

/// Outcome graph node for unified querying across accounts, people, messages, meetings, tasks, stages, and revenue.
model OutcomeGraphNode {
  id           String        @id @default(cuid()) @db.VarChar(32)
  nodeType     GraphNodeType
  nodeId       String
  workspaceKey String
  title        String
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([nodeType, nodeId, workspaceKey])
  @@index([workspaceKey, nodeType, createdAt])
  @@map("outcome_graph_nodes")
}

/// Outcome graph edge connecting nodes with typed relationships.
model OutcomeGraphEdge {
  id           String        @id @default(cuid()) @db.VarChar(32)
  workspaceKey String
  sourceType   GraphNodeType
  sourceId     String
  targetType   GraphNodeType
  targetId     String
  edgeType     GraphEdgeType
  weight       Float         @default(1)
  metadata     Json          @default("{}")
  createdAt    DateTime      @default(now())

  @@index([workspaceKey, sourceType, targetType])
  @@index([sourceType, sourceId, targetType, targetId])
  @@map("outcome_graph_edges")
}

enum EvidenceEntityType {
  ACCOUNT_RANK
  PLAYBOOK_STEP
  SEQUENCE_VARIANT
  PITCH
  AGENT_RUN
  SIGNAL
}

enum EvidenceReviewStatus {
  PENDING
  APPROVED
  REJECTED
  DECAYED
}

enum AutomationActionType {
  SEQUENCE_STEP_EXECUTED
  PITCH_SENT
  PITCH_SCHEDULED
  LEAD_STAGE_CHANGED
  OPPORTUNITY_CREATED
  MEETING_BOOKED
  AGENT_RUN_STARTED
  AGENT_RUN_COMPLETED
  CRM_UPDATE
  CONTACT_EXPORT
}

enum AutomationEntityType {
  SEQUENCE_EXECUTION
  PITCH
  LEAD
  OPPORTUNITY
  MEETING
  AGENT_RUN
  PLAYBOOK_VERSION
  ACCOUNT
  EVIDENCE_REVIEW
}

enum AutomationActorType {
  USER
  AGENT
  SCHEDULER
  SYSTEM
}

enum GraphNodeType {
  ACCOUNT
  CONTACT
  LEAD
  OPPORTUNITY
  RELATIONSHIP
  PITCH
  MEETING
  TASK
  STAGE
  REVENUE
  SIGNAL
  CONVERSATION
  DOCUMENT
}

enum GraphEdgeType {
  OWNS
  SENDS
  ATTENDS
  CREATES
  ATTRIBUTES_TO
  LEADS_TO
  PART_OF
  REFERENCES
}

enum SignalType {
  HIRING
  FUNDING
  LEADERSHIP_CHANGE
  TECHNOLOGY
  INTENT
  PRODUCT_USAGE
  RENEWAL
  RELATIONSHIP_ACTIVITY
}

enum AgentType {
  RESEARCH
  ROUTING
  BRIEFING
  FOLLOW_UP
  CRM_HYGIENE
}

enum AgentStatus {
  IDLE
  RUNNING
  PAUSED
  COMPLETED
  FAILED
  AWAITING_APPROVAL
}

enum PackVisibility {
  PRIVATE
  CURATED
}
