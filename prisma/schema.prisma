model DealQueue {
  id          String      @id @default(cuid()) @db.VarChar(32)
  name        String
  description String      @default("")
  type        String
  isActive    Boolean     @default(true)
  createdById String
  createdBy   User        @relation("QueueCreator", fields: [createdById], references: [id], onDelete: Cascade)
