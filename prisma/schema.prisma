// Prisma schema for Unitel Global — CarrierScout AI
// Shared team B2B platform: users, leads, CRM pipeline, outreach pitches, activity log.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Application user (Unitel Global B2B worker).
model User {
  id           String   @id @default(cuid()) @db.VarChar(32)
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(AGENT)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  assignedLeads                 Lead[]                  @relation("AssignedAgent")
  createdLeads                  Lead[]                  @relation("LeadCreator")
  pitches                       Pitch[]
  activities                    ActivityLog[]
  createdTemplates              PitchTemplate[]         @relation("TemplateCreator")
  deals                         Deal[]                  @relation("AgentDeals")
  commissions                   Commission[]            @relation("AgentCommissions")
  routingRules                  LeadRoutingRule[]       @relation("RoutingAgent")
  meetingSlots                  MeetingSlot[]           @relation("MeetingSlots")
  availabilityRules             AvailabilityRule[]      @relation("AvailabilityRules")
  bookingLinks                  BookingLink[]           @relation("BookingAgents")
  createdDocuments              GeneratedDocument[]     @relation("DocumentCreator")
  apiKeys                       ApiKey[]                @relation("ApiKeys")
  sendTimeOptimizations         SendTimeOptimization[]  @relation("SendTimeOptimizations")
  coachingInsights              AgentCoaching[]         @relation("AgentCoaching")
  scheduledMeetings             Meeting[]               @relation("AgentMeetings")
  ownedAccounts                 Account[]               @relation("AccountOwner")
  ownedContacts                 Contact[]               @relation("ContactOwner")
  ownedOpportunities            Opportunity[]           @relation("OpportunityOwner")
  ownedRelationships            Relationship[]          @relation("RelationshipOwner")
  integrationConnections        IntegrationConnection[]
  ownedConversations            Conversation[]          @relation("ConversationOwner")
  timelineEntries               TimelineEntry[]         @relation("TimelineActor")
  teamBookingMemberships        TeamBookingMember[]
  createdPlaybooks              Playbook[]              @relation("PlaybookCreator")
  createdQualificationPlaybooks QualificationPlaybook[] @relation("QualificationCreator")
  createdQueues                 DealQueue[]             @relation("QueueCreator")
  createdWebhooks               OutboundWebhook[]       @relation("WebhookCreator")
  createdIntegrationMappings    IntegrationMapping[]    @relation("IntegrationMappingCreator")
  playbookTestRuns              PlaybookTestRun[]       @relation("PlaybookTestCreator")
  playbookApprovalsRequested    PlaybookApproval[]      @relation("PlaybookApprovalRequester")
  playbookApprovalsReviewed     PlaybookApproval[]      @relation("PlaybookApprover")
  checkedQualifications         DealQualification[]     @relation("QualificationChecker")
  queueItemAssignments          QueueItem[]             @relation("QueueItemAssignee")
  workloadCaps                  WorkloadCap[]           @relation("UserWorkload")

  createdAgentDefinitions AgentDefinition[]    @relation("AgentCreator")
  createdPacks            PlaybookPack[]       @relation("PackCreator")
  agentApprovalsReviewed  AgentApproval[]      @relation("AgentApprover")
  evidenceReviewsCreated  EvidenceReview[]     @relation("EvidenceReviewCreator")
  evidenceReviewsReviewed EvidenceReview[]     @relation("EvidenceReviewer")
  workspaceThresholds     WorkspaceThreshold[] @relation("UserWorkspaceThresholds")

  @@index([role])
  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
  AGENT
}

/// Key/value application settings editable from the UI (overrides .env at runtime).
/// Secret values (API keys, passwords) are stored encrypted; `isSecret` marks them.
model AppSetting {
  key         String   @id @db.VarChar(32)
  value       String   @default("")
  isSecret    Boolean  @default(false)
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@map("app_settings")
}

/// A B2B company lead in the shared team pipeline.
model Lead {
  id              String     @id @default(cuid()) @db.VarChar(32)
  name            String
  website         String
  domain          String // normalized website host (lowercase, no protocol/www) for dedupe
  category        String
  email           String
  description     String     @default("")
  phone           String?
  sourceUrl       String?
  focus           String? // LeadFocus segment (voip_carriers, sms_aggregators, ...)
  source          LeadSource @default(AI_SCOUT)
  isVerified      Boolean    @default(false)
  stage           String     @default("DISCOVERED")
  notes           String     @default("")
  estimatedValue  Int        @default(0) // Potential monthly value in EUR
  aiScore         Int? // AI-calculated conversion probability 0-100
  aiScoreReason   String? // Explanation for the AI score
  enrichmentData  Json? // company size, tech stack, news, decision makers
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastContactedAt DateTime?

  assignedAgentId String?
  assignedAgent   User?   @relation("AssignedAgent", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  createdById String?
  createdBy   User?   @relation("LeadCreator", fields: [createdById], references: [id], onDelete: SetNull)

  followUpTask           FollowUpTask?
  meetings               Meeting[]
  pitches                Pitch[]
  activities             ActivityLog[]
  customFieldValues      CustomFieldValue[]
  sequenceExecutions     SequenceExecution[]
  deals                  Deal[]
  documents              GeneratedDocument[]
  monitoringAlerts       LeadMonitoring[]
  sendTimeOptimizations  SendTimeOptimization[]
  bookingLinks           BookingLink[]
  accountId              String?
  account                Account?                @relation(fields: [accountId], references: [id], onDelete: SetNull)
  primaryContact         Contact?
  opportunities          Opportunity[]
  relationships          Relationship[]
  conversations          Conversation[]
  timelineEntries        TimelineEntry[]
  externalCalendarEvents ExternalCalendarEvent[]

  @@unique([website, email])
  @@index([domain])
  @@index([email])
  @@index([stage])
  @@index([assignedAgentId])
  @@index([focus])
  @@index([accountId])
  @@map("leads")
}

/// Company-level record. Existing leads are linked to an account by migration.
model Account {
  id          String   @id @default(cuid()) @db.VarChar(32)
  name        String
  domain      String?
  website     String?
  industry    String?
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  ownerId String?
  owner   User?   @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  legacyLeads            Lead[]
  contacts               Contact[]
  opportunities          Opportunity[]
  relationships          Relationship[]
  conversations          Conversation[]
  timelineEntries        TimelineEntry[]
  externalCalendarEvents ExternalCalendarEvent[]
  signals                AccountSignal[]
  ranks                  AccountRank[]           @relation("AccountRanks")

  @@unique([domain])
  @@index([ownerId])
  @@index([updatedAt])
  @@map("accounts")
}

/// Person-level record attached to an account and optionally backed by a legacy lead.
model Contact {
  id            String   @id @default(cuid()) @db.VarChar(32)
  fullName      String
  firstName     String?
  lastName      String?
  email         String
  phone         String?
  title         String?
  consentStatus String   @default("UNKNOWN")
  consentSource String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  accountId    String
  account      Account @relation(fields: [accountId], references: [id], onDelete: Cascade)
  ownerId      String?
  owner        User?   @relation("ContactOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  legacyLeadId String? @unique
  legacyLead   Lead?   @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)

  primaryOpportunities   Opportunity[]           @relation("PrimaryOpportunityContact")
  relationships          Relationship[]
  conversations          Conversation[]
  timelineEntries        TimelineEntry[]
  externalCalendarEvents ExternalCalendarEvent[]

  @@index([accountId, email])
  @@index([email])
  @@index([ownerId])
  @@map("contacts")
}

model Opportunity {
  id              String            @id @default(cuid()) @db.VarChar(32)
  name            String
  stage           String            @default("DISCOVERY")
  status          OpportunityStatus @default(OPEN)
  value           Int               @default(0)
  currency        String            @default("EUR")
  probability     Int               @default(10)
  expectedCloseAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  accountId        String
  account          Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  primaryContactId String?
  primaryContact   Contact? @relation("PrimaryOpportunityContact", fields: [primaryContactId], references: [id], onDelete: SetNull)
  legacyLeadId     String?
  legacyLead       Lead?    @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  ownerId          String?
  owner            User?    @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  relationships   Relationship[]
  timelineEntries TimelineEntry[]

  @@index([accountId, status])
  @@index([ownerId, updatedAt])
  @@index([legacyLeadId])
  @@map("opportunities")
}

enum OpportunityStatus {
  OPEN
  WON
  LOST
}

model Relationship {
  id                String             @id @default(cuid()) @db.VarChar(32)
  type              RelationshipType   @default(PROSPECT)
  status            RelationshipStatus @default(ACTIVE)
  strength          Int                @default(0)
  lastInteractionAt DateTime?
  nextActionAt      DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  accountId     String
  account       Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId     String?
  contact       Contact?     @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId String?
  opportunity   Opportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  legacyLeadId  String?
  legacyLead    Lead?        @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  ownerId       String?
  owner         User?        @relation("RelationshipOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  timelineEntries TimelineEntry[]

  @@index([accountId, status])
  @@index([contactId])
  @@index([ownerId, nextActionAt])
  @@index([legacyLeadId])
  @@map("relationships")
}

enum RelationshipType {
  PROSPECT
  CUSTOMER
  PARTNER
  RECRUITING
  CHANNEL
  OTHER
}

enum RelationshipStatus {
  ACTIVE
  PAUSED
  CLOSED
}

enum LeadSource {
  AI_SCOUT
  MANUAL
  CSV_IMPORT
  PITCH_REPLY
  OTHER
}

/// A single actionable follow-up task attached to a lead.
model FollowUpTask {
  id          String   @id @default(cuid()) @db.VarChar(32)
  taskName    String
  dueDate     DateTime
  isCompleted Boolean  @default(false)
  notes       String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  leadId String @unique
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@map("follow_up_tasks")
}

/// A scheduled meeting/call/demo with a lead.
model Meeting {
  id        String      @id @default(cuid()) @db.VarChar(32)
  title     String
  date      String // YYYY-MM-DD
  time      String // HH:MM
  duration  Int         @default(30) // minutes
  type      MeetingType @default(CALL)
  agenda    String      @default("")
  link      String?
  timezone  String      @default("Europe/Tallinn")
  createdAt DateTime    @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  pitchId String?
  pitch   Pitch?  @relation("MeetingPitches", fields: [pitchId], references: [id], onDelete: SetNull)

  agentId String?
  agent   User?   @relation("AgentMeetings", fields: [agentId], references: [id], onDelete: SetNull)

  slots       MeetingSlot[]
  bookingLink BookingLink?

  @@index([leadId])
  @@index([agentId])
  @@map("meetings")
}

/// Available time slots for booking (Calendly-like)
model MeetingSlot {
  id          String   @id @default(cuid()) @db.VarChar(32)
  date        String // YYYY-MM-DD
  startTime   String // HH:MM
  endTime     String // HH:MM
  timezone    String   @default("Europe/Tallinn")
  isAvailable Boolean  @default(true)
  isBooked    Boolean  @default(false)
  agentId     String
  agent       User     @relation("MeetingSlots", fields: [agentId], references: [id])
  meetingId   String? // linked meeting if booked
  meeting     Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@unique([agentId, date, startTime])
  @@index([agentId])
  @@index([date])
  @@index([agentId, date, isAvailable, isBooked])
  @@map("meeting_slots")
}

model WebhookReceipt {
  id              String   @id @default(cuid()) @db.VarChar(32)
  provider        String
  providerEventId String
  receivedAt      DateTime @default(now())

  @@unique([provider, providerEventId])
  @@index([receivedAt])
  @@map("webhook_receipts")
}

/// A recurring weekly availability window for an agent.
model AvailabilityRule {
  id           String   @id @default(cuid()) @db.VarChar(32)
  weekday      Int
  startTime    String
  endTime      String
  slotDuration Int      @default(30)
  timezone     String   @default("Europe/Tallinn")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  agentId String
  agent   User   @relation("AvailabilityRules", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, weekday])
  @@index([agentId, isActive])
  @@map("availability_rules")
}

/// Capability link included in outreach emails for public meeting booking.
model BookingLink {
  id        String    @id @default(cuid()) @db.VarChar(32)
  token     String    @unique
  expiresAt DateTime
  bookedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  pitchId String @unique
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  agentId String
  agent   User   @relation("BookingAgents", fields: [agentId], references: [id], onDelete: Cascade)

  meetingId String?  @unique
  meeting   Meeting? @relation(fields: [meetingId], references: [id], onDelete: SetNull)

  @@index([agentId])
  @@index([leadId])
  @@index([expiresAt])
  @@map("booking_links")
}

enum MeetingType {
  CALL
  MEETING
  DEMO
  FOLLOW_UP
}

/// A generated / sent outreach email pitch.
model Pitch {
  id              String      @id @default(cuid()) @db.VarChar(32)
  subject         String
  htmlContent     String
  textContent     String
  language        String      @default("English")
  status          PitchStatus @default(DRAFT)
  opened          Boolean     @default(false)
  sentAt          DateTime?
  scheduledSendAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  leadId    String
  lead      Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadName  String
  leadEmail String

  createdById String?
  createdBy   User?   @relation(fields: [createdById], references: [id], onDelete: SetNull)

  sentFromEmail String? // actual sender email used at send time (for audit)
  sentFromName  String? // actual sender name used at send time
  replyToEmail  String? // where replies should go (agent email or SMTP from)
  sentMessageId String? // SMTP Message-ID for reply threading

  inReplyTo       Pitch?           @relation("ReplyChain", fields: [inReplyToId], references: [id], onDelete: SetNull)
  inReplyToId     String?          @unique
  replies         Pitch[]          @relation("ReplyChain")
  meetings        Meeting[]        @relation("MeetingPitches")
  bookingLink     BookingLink?
  unsubscribeLink UnsubscribeLink?

  events PitchEvent[]

  @@index([leadId])
  @@index([status])
  @@index([status, scheduledSendAt])
  @@map("pitches")
}

enum PitchStatus {
  DRAFT
  SENDING
  SENT
  DELIVERED
  REPLIED
  FAILED
}

/// Audit trail of actions across the team pipeline.
model ActivityLog {
  id        String    @id @default(cuid()) @db.VarChar(32)
  action    String
  detail    String    @default("")
  createdAt DateTime  @default(now())
  readAt    DateTime?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([userId])
  @@index([userId, readAt])
  @@map("activity_logs")
}

/// OAuth connection for Gmail/Google Calendar or Outlook/Microsoft Calendar.
model IntegrationConnection {
  id                 String              @id @default(cuid()) @db.VarChar(32)
  provider           IntegrationProvider
  status             IntegrationStatus   @default(ACTIVE)
  accountEmail       String?
  scopes             String[]            @default([])
  accessToken        String
  refreshToken       String?
  expiresAt          DateTime?
  mailCursor         String?
  calendarCursor     String?
  lastMailSyncAt     DateTime?
  lastCalendarSyncAt DateTime?
  lastError          String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  userId         String
  user           User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversations  Conversation[]
  calendarEvents ExternalCalendarEvent[]

  @@unique([userId, provider])
  @@index([provider, status])
  @@map("integration_connections")
}

model OAuthSession {
  id           String              @id @default(cuid()) @db.VarChar(32)
  stateHash    String              @unique
  provider     IntegrationProvider
  codeVerifier String
  returnTo     String?
  expiresAt    DateTime
  createdAt    DateTime            @default(now())

  userId String

  @@index([userId, provider])
  @@index([expiresAt])
  @@map("oauth_sessions")
}

enum IntegrationProvider {
  GOOGLE
  MICROSOFT
}

enum IntegrationStatus {
  ACTIVE
  NEEDS_REAUTH
  DISCONNECTED
  ERROR
}

model Conversation {
  id               String                @id @default(cuid()) @db.VarChar(32)
  externalThreadId String
  subject          String                @default("")
  participants     Json?
  status           ConversationStatus    @default(OPEN)
  unreadCount      Int                   @default(0)
  summary          String?
  sentiment        RelationshipSentiment @default(NEUTRAL)
  intent           RelationshipIntent    @default(OTHER)
  suggestedReply   String?
  slaDueAt         DateTime?
  snoozedUntil     DateTime?
  lastMessageAt    DateTime
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId    String?
  account      Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  legacyLeadId String?
  legacyLead   Lead?                 @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  ownerId      String?
  owner        User?                 @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  messages        ConversationMessage[]
  timelineEntries TimelineEntry[]

  @@unique([connectionId, externalThreadId])
  @@index([ownerId, status, lastMessageAt])
  @@index([contactId])
  @@index([legacyLeadId])
  @@map("conversations")
}

enum ConversationStatus {
  OPEN
  WAITING
  SNOOZED
  DONE
}

model ConversationMessage {
  id                String                @id @default(cuid()) @db.VarChar(32)
  externalMessageId String
  internetMessageId String?
  direction         MessageDirection
  senderEmail       String
  recipientEmails   Json
  ccEmails          Json?
  subject           String                @default("")
  textBody          String                @default("")
  occurredAt        DateTime
  isRead            Boolean               @default(false)
  intent            RelationshipIntent    @default(OTHER)
  sentiment         RelationshipSentiment @default(NEUTRAL)
  createdAt         DateTime              @default(now())

  conversationId String
  conversation   Conversation   @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  timelineEntry  TimelineEntry?

  @@unique([conversationId, externalMessageId])
  @@index([internetMessageId])
  @@index([occurredAt])
  @@map("conversation_messages")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum RelationshipSentiment {
  POSITIVE
  NEUTRAL
  NEGATIVE
}

enum RelationshipIntent {
  INTERESTED
  MEETING_REQUEST
  QUESTION
  OBJECTION
  UNSUBSCRIBE
  OTHER
}

model TimelineEntry {
  id         String            @id @default(cuid()) @db.VarChar(32)
  type       TimelineEntryType
  title      String
  body       String            @default("")
  metadata   Json?
  sourceType String?
  sourceId   String?
  dedupeKey  String?           @unique
  occurredAt DateTime
  createdAt  DateTime          @default(now())

  accountId      String?
  account        Account?             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?             @relation(fields: [contactId], references: [id], onDelete: SetNull)
  opportunityId  String?
  opportunity    Opportunity?         @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  relationshipId String?
  relationship   Relationship?        @relation(fields: [relationshipId], references: [id], onDelete: SetNull)
  legacyLeadId   String?
  legacyLead     Lead?                @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  conversationId String?
  conversation   Conversation?        @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  messageId      String?              @unique
  message        ConversationMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)
  actorId        String?
  actor          User?                @relation("TimelineActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([accountId, occurredAt])
  @@index([legacyLeadId, occurredAt])
  @@index([contactId, occurredAt])
  @@map("timeline_entries")
}

enum TimelineEntryType {
  EMAIL
  REPLY
  MEETING
  TASK
  NOTE
  DOCUMENT
  STAGE_CHANGE
  OPPORTUNITY
  UNSUBSCRIBE
  BOUNCE
}

model ExternalCalendarEvent {
  id              String                      @id @default(cuid()) @db.VarChar(32)
  externalEventId String
  calendarId      String                      @default("primary")
  title           String
  description     String                      @default("")
  startAt         DateTime
  endAt           DateTime
  timezone        String                      @default("UTC")
  status          ExternalCalendarEventStatus @default(CONFIRMED)
  isBusy          Boolean                     @default(true)
  organizerEmail  String?
  attendeeEmails  Json?
  etag            String?
  reminderMinutes Int?
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt

  connectionId String
  connection   IntegrationConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  accountId    String?
  account      Account?              @relation(fields: [accountId], references: [id], onDelete: SetNull)
  contactId    String?
  contact      Contact?              @relation(fields: [contactId], references: [id], onDelete: SetNull)
  legacyLeadId String?
  legacyLead   Lead?                 @relation(fields: [legacyLeadId], references: [id], onDelete: SetNull)
  meetingId    String?               @unique

  @@unique([connectionId, externalEventId])
  @@index([connectionId, startAt, endAt])
  @@index([legacyLeadId])
  @@map("external_calendar_events")
}

enum ExternalCalendarEventStatus {
  CONFIRMED
  TENTATIVE
  CANCELLED
}

model TeamBookingPage {
  id          String   @id @default(cuid()) @db.VarChar(32)
  slug        String   @unique
  name        String
  description String   @default("")
  duration    Int      @default(30)
  timezone    String   @default("Europe/Tallinn")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members TeamBookingMember[]

  @@index([isActive])
  @@map("team_booking_pages")
}

model TeamBookingMember {
  id             String    @id @default(cuid()) @db.VarChar(32)
  priority       Int       @default(100)
  isActive       Boolean   @default(true)
  lastAssignedAt DateTime?

  pageId String
  page   TeamBookingPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  userId String
  user   User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([pageId, userId])
  @@index([pageId, isActive, priority])
  @@map("team_booking_members")
}

/// Individual pitch delivery/open event from Resend webhook or manual tracking.
model PitchEvent {
  id        String         @id @default(cuid()) @db.VarChar(32)
  pitchId   String
  pitch     Pitch          @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  type      PitchEventType
  createdAt DateTime       @default(now())

  @@index([pitchId])
  @@map("pitch_events")
}

enum PitchEventType {
  SENT
  DELIVERED
  OPENED
  CLICKED
  REPLIED
  BOUNCED
  COMPLAINED
  FAILED
}

/// Recipient-level do-not-contact entry enforced before every outreach send.
model EmailSuppression {
  id          String   @id @default(cuid()) @db.VarChar(32)
  email       String   @unique
  reason      String
  source      String
  createdById String?
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@map("email_suppressions")
}

/// Non-expiring capability included in an outreach footer so a recipient can opt out.
model UnsubscribeLink {
  id        String   @id @default(cuid()) @db.VarChar(32)
  token     String   @unique
  email     String
  createdAt DateTime @default(now())

  pitchId String @unique
  pitch   Pitch  @relation(fields: [pitchId], references: [id], onDelete: Cascade)

  @@index([email])
  @@map("unsubscribe_links")
}

/// Product funnel instrumentation for activation, outreach, and booking outcomes.
model ActivationEvent {
  id        String   @id @default(cuid()) @db.VarChar(32)
  type      String
  userId    String?
  leadId    String?
  pitchId   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([type, createdAt])
  @@index([userId, createdAt])
  @@index([leadId])
  @@index([pitchId])
  @@map("activation_events")
}

/// Saved pitch template for reuse across the team.
model PitchTemplate {
  id          String   @id @default(cuid()) @db.VarChar(32)
  name        String
  subject     String
  htmlContent String
  textContent String
  focus       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdById String?
  createdBy   User?   @relation("TemplateCreator", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([createdById])
  @@map("pitch_templates")
}

/// Custom field definition for leads (admin-configurable).
model CustomFieldDefinition {
  id         String          @id @default(cuid()) @db.VarChar(32)
  name       String
  key        String // machine-readable key, e.g. "contract_value"
  type       CustomFieldType @default(TEXT)
  options    String? // JSON array for SELECT/MULTISELECT types
  isRequired Boolean         @default(false)
  sortOrder  Int             @default(0)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  values CustomFieldValue[]

  @@unique([key])
  @@map("custom_field_definitions")
}

enum CustomFieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  MULTISELECT
  BOOLEAN
}

/// Value of a custom field for a specific lead.
model CustomFieldValue {
  id        String   @id @default(cuid()) @db.VarChar(32)
  value     String // stored as string, cast based on field type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  fieldId String
  field   CustomFieldDefinition @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@unique([leadId, fieldId])
  @@index([leadId])
  @@index([fieldId])
  @@map("custom_field_values")
}

/// Custom pipeline stage (admin-configurable, replaces default LeadStage when active).
model DealStage {
  id        String   @id @default(cuid()) @db.VarChar(32)
  name      String
  key       String   @unique // machine-readable key, e.g. "demo_scheduled"
  color     String   @default("#64748b") // hex color for UI
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("deal_stages")
}

/// Automated follow-up sequence (e.g. "Cold Outreach", "Demo Follow-up").
model FollowUpSequence {
  id           String              @id @default(cuid()) @db.VarChar(32)
  name         String
  description  String              @default("")
  triggerStage String // LeadStage key that triggers this sequence
  isActive     Boolean             @default(true)
  stopEvents   SequenceStopEvent[] @default([REPLY, UNSUBSCRIBE, BOUNCE, MEETING])
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  steps      SequenceStep[]
  executions SequenceExecution[]

  @@map("follow_up_sequences")
}

/// Single step in a follow-up sequence.
model SequenceStep {
  id             String             @id @default(cuid()) @db.VarChar(32)
  order          Int
  delayDays      Int                @default(0) // days after previous step
  actionType     SequenceActionType @default(TASK)
  subject        String?
  body           String?
  taskName       String?
  isActive       Boolean            @default(true)
  triggerEvent   PitchEventType? // pitch event that triggers this step
  eventDelayDays Int? // delay in days when trigger event fires (null = use delayDays)
  stopOnEvent    Boolean            @default(false) // complete sequence when trigger event fires
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([sequenceId])
  @@map("sequence_steps")
}

enum SequenceActionType {
  EMAIL
  TASK
  WEBHOOK
}

/// Execution of a sequence for a specific lead.
model SequenceExecution {
  id                  String                  @id @default(cuid()) @db.VarChar(32)
  status              SequenceExecutionStatus @default(ACTIVE)
  currentStep         Int                     @default(0)
  startedAt           DateTime                @default(now())
  completedAt         DateTime?
  nextRunAt           DateTime?
  lastEventCheckedAt  DateTime? // last time pitch events were checked for trigger events
  triggeredStep       Int?
  processingStep      Int?
  processingStartedAt DateTime?
  stoppedByEvent      SequenceStopEvent?

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  sequenceId String
  sequence   FollowUpSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([sequenceId])
  @@index([status, nextRunAt])
  @@map("sequence_executions")
}

enum SequenceExecutionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  STOPPED
}

enum SequenceStopEvent {
  REPLY
  UNSUBSCRIBE
  BOUNCE
  MEETING
  SUCCESS
}

/// A closed-won deal with value and commission tracking.
model Deal {
  id             String       @id @default(cuid()) @db.VarChar(32)
  leadId         String
  lead           Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  value          Int // Total deal value in EUR
  commissionRate Float        @default(10.0) // Agent commission percentage
  commission     Int // Commission amount in EUR
  agentId        String
  agent          User         @relation("AgentDeals", fields: [agentId], references: [id])
  closedAt       DateTime     @default(now())
  notes          String       @default("")
  commissions    Commission[]

  @@index([agentId])
  @@index([closedAt])
  @@map("deals")
}

/// Commission record for an agent on a specific deal.
model Commission {
  id        String           @id @default(cuid()) @db.VarChar(32)
  dealId    String
  deal      Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  agentId   String
  agent     User             @relation("AgentCommissions", fields: [agentId], references: [id])
  amount    Int // Commission in EUR
  status    CommissionStatus @default(PENDING)
  paidAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([agentId])
  @@index([status])
  @@map("commissions")
}

enum CommissionStatus {
  PENDING
  PAID
  CANCELLED
}

/// Automated lead routing rules for assigning leads to agents.
model LeadRoutingRule {
  id              String          @id @default(cuid()) @db.VarChar(32)
  name            String
  isActive        Boolean         @default(true)
  priority        Int             @default(0)
  ruleType        RoutingRuleType
  criteria        String // JSON: { territory: "...", focus: "...", maxLeads: 5 }
  assignedAgentId String
  assignedAgent   User            @relation("RoutingAgent", fields: [assignedAgentId], references: [id])
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([assignedAgentId])
  @@index([isActive])
  @@map("lead_routing_rules")
}

enum RoutingRuleType {
  TERRITORY
  INDUSTRY
  ROUND_ROBIN
  MANUAL
  SCORE_BASED
}

/// Document template for proposals, contracts, etc.
model DocumentTemplate {
  id        String       @id @default(cuid()) @db.VarChar(32)
  name      String
  type      DocumentType
  content   String // HTML or markdown template
  variables String       @default("[]") // JSON array of available variables
  isDefault Boolean      @default(false)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@index([type])
  @@map("document_templates")
}

/// Generated document for a lead/deal
model GeneratedDocument {
  id          String       @id @default(cuid()) @db.VarChar(32)
  title       String
  type        DocumentType
  content     String // Final rendered HTML
  pdfUrl      String? // Path to generated PDF
  leadId      String?
  lead        Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdById String
  createdBy   User         @relation("DocumentCreator", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([leadId])
  @@index([type])
  @@map("generated_documents")
}

enum DocumentType {
  PROPOSAL
  CONTRACT
  NDA
  QUOTE
  INVOICE
  CUSTOM
}

/// API keys for external integrations (Zapier, Make, custom scripts).
model ApiKey {
  id         String    @id @default(cuid()) @db.VarChar(32)
  name       String
  keyHash    String    @unique @map("key")
  keyPrefix  String
  scopes     String    @default("[]")
  isRevoked  Boolean   @default(false)
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  userId String
  user   User   @relation("ApiKeys", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([keyPrefix])
  @@map("api_keys")
}

/// Monitoring alert for a lead (news, events, changes).
model LeadMonitoring {
  id          String         @id @default(cuid()) @db.VarChar(32)
  leadId      String
  lead        Lead           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  type        MonitoringType @default(NEWS)
  title       String
  description String         @default("")
  source      String? // URL or source name
  isRead      Boolean        @default(false)
  createdAt   DateTime       @default(now())

  @@index([leadId])
  @@index([createdAt])
  @@map("lead_monitoring")
}

enum MonitoringType {
  NEWS
  EVENT
  FUNDING
  HIRING
  COMPETITOR
  CUSTOM
}

/// Send-time optimization record for a lead/agent combination.
model SendTimeOptimization {
  id              String    @id @default(cuid()) @db.VarChar(32)
  leadId          String
  lead            Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  agentId         String?
  agent           User?     @relation("SendTimeOptimizations", fields: [agentId], references: [id], onDelete: SetNull)
  recommendedHour Int // 0-23
  recommendedDay  String // "Monday", "Tuesday", etc.
  confidence      Int // 0-100
  reason          String    @default("")
  createdAt       DateTime  @default(now())
  lastUsedAt      DateTime?

  @@index([leadId])
  @@index([agentId])
  @@map("send_time_optimizations")
}

/// Agent coaching insight based on performance analysis.
model AgentCoaching {
  id          String   @id @default(cuid()) @db.VarChar(32)
  agentId     String
  agent       User     @relation("AgentCoaching", fields: [agentId], references: [id], onDelete: Cascade)
  insightType String // "STAGE_TRANSITION", "RESPONSE_RATE", "PITCH_QUALITY", "FOLLOW_UP", "GENERAL"
  title       String
  description String
  priority    String   @default("MEDIUM") // LOW, MEDIUM, HIGH
  isRead      Boolean  @default(false)
  isResolved  Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([agentId])
  @@index([createdAt])
  @@map("agent_coaching")
}

// Update User model to include relations

// === Phase 2: Playbooks that learn ===

enum PlaybookType {
  OUTREACH
  QUALIFICATION
  NURTURING
  CUSTOM
}

enum PlaybookStatus {
  DRAFT
  TESTING
  PUBLISHED
  ARCHIVED
}

enum PlaybookVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
  PUBLISHED
  ROLLED_BACK
}

enum TestModeStatus {
  IDLE
  RUNNING
  COMPLETED
  FAILED
}

enum AttributionOutcome {
  POSITIVE_REPLY
  QUALIFIED_MEETING
  STAGE_CHANGE
  WIN
  REVENUE
}

enum QualificationFramework {
  BANT
  MEDDPICC
  SPICED
  CUSTOM
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum WebhookEventType {
  PLAYBOOK_PUBLISHED
  STAGE_CHANGED
  ATTRIBUTION_UPDATED
  APPROVAL_REQUESTED
  APPROVAL_DECIDED
  DEAL_STALLED
  SLA_BREACHED
}

enum RetryPolicy {
  NONE
  LINEAR
  EXPONENTIAL
}

model Playbook {
  id          String            @id @default(cuid()) @db.VarChar(32)
  name        String
  description String            @default("")
  type        PlaybookType      @default(OUTREACH)
  status      PlaybookStatus    @default(DRAFT)
  isActive    Boolean           @default(true)
  createdById String
  createdBy   User              @relation("PlaybookCreator", fields: [createdById], references: [id], onDelete: Cascade)
  versions    PlaybookVersion[]
  packItems   PackItem[]        @relation("PackItems")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([type])
  @@index([status])
  @@index([createdById])
  @@map("playbooks")
}

model PlaybookVersion {
  id                      String                @id @default(cuid()) @db.VarChar(32)
  version                 Int
  changelog               String                @default("")
  status                  PlaybookVersionStatus @default(DRAFT)
  isActive                Boolean               @default(false)
  rolledBackFromVersionId String?
  playbookId              String
  playbook                Playbook              @relation(fields: [playbookId], references: [id], onDelete: Cascade)
  steps                   PlaybookStep[]
  conditions              PlaybookCondition[]
  actions                 PlaybookAction[]
  branches                PlaybookBranch[]
  testRuns                PlaybookTestRun[]
  approvals               PlaybookApproval[]
  attributions            PlaybookAttribution[]
  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  @@unique([playbookId, version])
  @@index([playbookId, status])
  @@map("playbook_versions")
}

model PlaybookStep {
  id          String              @id @default(cuid()) @db.VarChar(32)
  order       Int
  name        String
  description String              @default("")
  isActive    Boolean             @default(true)
  versionId   String
  version     PlaybookVersion     @relation(fields: [versionId], references: [id], onDelete: Cascade)
  analytics   StepLevelAnalytics?

  @@index([versionId, order])
  @@map("playbook_steps")
}

model PlaybookCondition {
  id          String          @id @default(cuid()) @db.VarChar(32)
  operator    String
  value       String
  field       String
  description String          @default("")
  versionId   String
  version     PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("playbook_conditions")
}

model PlaybookAction {
  id          String          @id @default(cuid()) @db.VarChar(32)
  type        String
  config      String          @default("{}")
  description String          @default("")
  retryPolicy RetryPolicy     @default(NONE)
  maxAttempts Int             @default(3)
  versionId   String
  version     PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("playbook_actions")
}

model PlaybookBranch {
  id              String          @id @default(cuid()) @db.VarChar(32)
  name            String
  condition       String
  targetStepOrder Int
  versionId       String
  version         PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@map("playbook_branches")
}

model PlaybookTestRun {
  id           String          @id @default(cuid()) @db.VarChar(32)
  status       TestModeStatus  @default(IDLE)
  fakeLeadId   String?
  executionLog String          @default("[]")
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  createdById  String
  createdBy    User            @relation("PlaybookTestCreator", fields: [createdById], references: [id], onDelete: Cascade)
  versionId    String
  version      PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([createdById])
  @@map("playbook_test_runs")
}

model PlaybookApproval {
  id            String          @id @default(cuid()) @db.VarChar(32)
  status        ApprovalStatus  @default(PENDING)
  comment       String          @default("")
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    User?           @relation("PlaybookApprover", fields: [reviewedById], references: [id], onDelete: SetNull)
  versionId     String
  version       PlaybookVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  requestedById String
  requestedBy   User            @relation("PlaybookApprovalRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  createdAt     DateTime        @default(now())

  @@index([versionId, status])
  @@index([requestedById])
  @@map("playbook_approvals")
}

model StepLevelAnalytics {
  id                      String       @id @default(cuid()) @db.VarChar(32)
  stepId                  String       @unique
  step                    PlaybookStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  executions              Int          @default(0)
  positiveReplies         Int          @default(0)
  qualifiedMeetings       Int          @default(0)
  stageChanges            Int          @default(0)
  wins                    Int          @default(0)
  revenue                 Int          @default(0)
  dropoffRate             Float        @default(0)
  replyRate               Float        @default(0)
  conversionRate          Float        @default(0)
  confidenceInterval      Float        @default(0)
  sampleSizeWarning       Boolean      @default(false)
  minimumDetectableEffect Float        @default(0)
  revenueWeightedScore    Float        @default(0)
  lastCalculatedAt        DateTime     @default(now())

  @@index([stepId])
  @@map("step_level_analytics")
}

model PlaybookAttribution {
  id            String             @id @default(cuid()) @db.VarChar(32)
  outcome       AttributionOutcome
  outcomeValue  Int?
  metadata      String             @default("{}")
  accountId     String?
  contactId     String?
  opportunityId String?
  leadId        String?
  pitchId       String?
  stepId        String?
  versionId     String
  version       PlaybookVersion    @relation(fields: [versionId], references: [id], onDelete: Cascade)
  attributedAt  DateTime           @default(now())

  @@index([versionId, outcome])
  @@index([leadId])
  @@index([opportunityId])
  @@index([accountId])
  @@map("playbook_attributions")
}

model SequenceVersion {
  id                      String                 @id @default(cuid()) @db.VarChar(32)
  sequenceId              String
  version                 Int
  changelog               String                 @default("")
  isActive                Boolean                @default(false)
  rolledBackFromVersionId String?
  stepsJson               String
  abTests                 SequenceABTest[]
  executionLogs           SequenceExecutionLog[]
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt

  @@unique([sequenceId, version])
  @@index([sequenceId, isActive])
  @@map("sequence_versions")
}

model SequenceABTest {
  id              String          @id @default(cuid()) @db.VarChar(32)
  name            String
  status          String          @default("DRAFT")
  metric          String
  minSampleSize   Int             @default(100)
  confidenceLevel Float           @default(0.95)
  versionId       String
  version         SequenceVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  variants        ABTestVariant[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([versionId])
  @@map("sequence_ab_tests")
}

model ABTestVariant {
  id          String         @id @default(cuid()) @db.VarChar(32)
  name        String
  config      String         @default("{}")
  impressions Int            @default(0)
  conversions Int            @default(0)
  isControl   Boolean        @default(false)
  abTestId    String
  abTest      SequenceABTest @relation(fields: [abTestId], references: [id], onDelete: Cascade)

  @@index([abTestId])
  @@map("ab_test_variants")
}

model SequenceDeliveryWindow {
  id                       String   @id @default(cuid()) @db.VarChar(32)
  sequenceId               String?
  playbookId               String?
  weekdays                 Int[]
  startTime                String
  endTime                  String
  timezone                 String   @default("UTC")
  respectRecipientTimezone Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

